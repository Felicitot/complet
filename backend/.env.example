PORT=4000

# Origine(s) autorisée(s) pour le frontend, séparées par des virgules.
CORS_ORIGIN=http://localhost:5173

# Mot de passe de l'espace administrateur (pages Paramètres, Scripts & Tâches).
# À CHANGER. Sans cette variable, l'espace administrateur est désactivé.
ADMIN_PASSWORD=change-me

# Clé de signature des jetons (laisser vide = clé aléatoire à chaque démarrage,
# donc les administrateurs devront se reconnecter après un redémarrage).
TOKEN_SECRET=

# Dossiers (par défaut : ./data et ./scripts)
# DATA_DIR=/var/lib/rivotra
# SCRIPTS_DIR=/opt/rivotra/scripts

# Derrière un reverse proxy (nginx...) : 1
# TRUST_PROXY=1

# Délai minimal entre deux actualisations manuelles (ms)
# REFRESH_MIN_INTERVAL_MS=10000
