# --- Docker Compose ---
# Mot de passe de l'espace administrateur (Paramètres, Scripts & Tâches). À changer.
ADMIN_PASSWORD=Neyl1111&
# Clé de signature des jetons (génération : openssl rand -hex 32).
# Si vide, les administrateurs doivent se reconnecter après chaque redémarrage.
TOKEN_SECRET=
# Port public du portail
PORT=8080
# Origine autorisée (adresse publique du portail)
CORS_ORIGIN=http://localhost:8080
