@startuml
!include style.puml
title Diagramme de cas d'utilisation — Portail des guidances de prévision
left to right direction

actor "Prévisionniste" as P
actor "Administrateur /\nScripts de prévision" as A

rectangle "Rivotra — Météo Madagascar" {
  usecase "UC1\nConsulter une guidance\n(Vent, Pluies, Houles, Températures)" as UC1
  usecase "UC2\nTélécharger une image PNG" as UC2
  usecase "UC3\nActualiser le traitement" as UC3
  usecase "UC4\nCharger le Dashboard et\nconsulter le statut système" as UC4
  usecase "UC5\nConsulter la galerie satellite" as UC5
  usecase "UC6\nConsulter les prévisions spécifiques" as UC6
  usecase "UC7\nBrancher un script de prévision réel\n(évolution prévue)" as UC7
}

P --> UC1
P --> UC2
P --> UC3
P --> UC4
P --> UC5
P --> UC6
A --> UC7

UC2 .> UC1 : <<extend>>
UC7 .> UC3 : <<extend>>

note right of UC4
  UC4 s'exécute à l'ouverture du Dashboard,
  avant UC1, UC3, UC5 et UC6.
end note
@enduml
